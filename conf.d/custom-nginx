## Additional http settings
## Copy to custom-nginx.conf. This copy belongs to the server and may be adjusted.

# hide server information
server_tokens off;

# Enable gzip
gzip on;
gzip_vary on;
gzip_min_length 1024;
gzip_proxied any;
gzip_types
  text/plain
  text/css
  text/xml
  text/javascript
  application/javascript
  application/json
  application/manifest+json
  application/xml
  application/rss+xml
  application/atom+xml
  image/svg+xml;
