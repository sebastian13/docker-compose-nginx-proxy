# Site proxied by Cloudflare: SSL/TLS mode "Full (strict)" with a Cloudflare
# Origin CA certificate and Authenticated Origin Pulls (mutual Transport
# Layer Security, mTLS: Cloudflare authenticates itself to nginx with a
# client certificate).
# Copy to conf.d/<domain>.conf. Setup steps: README.md, section Cloudflare.
#
# Differences to example.com:
#   - no port 80 server: Cloudflare redirects to HTTPS at the edge ("Always
#     Use HTTPS") and connects to the origin via HTTPS only
#   - no certbot: the Origin CA certificate is valid for up to 15 years and
#     only trusted by Cloudflare, so the DNS record must stay proxied
#   - no HTTP/3: visitors talk HTTP/3 to Cloudflare, Cloudflare talks
#     HTTP/1.1 or HTTP/2 to the origin

server {
  server_name example.com;
  listen 443 ssl;
  listen [::]:443 ssl;
  http2 on;

  # Cloudflare Origin CA certificate, valid until <date>
  ssl_certificate         ssl/cloudflare/example.com/cert.pem;
  ssl_certificate_key     ssl/cloudflare/example.com/privkey.pem;

  # Set default SSL parameters
  include snippets/ssl.conf;

  # Only Cloudflare may connect: mutual TLS (mTLS), Cloudflare must present
  # its client certificate (Authenticated Origin Pulls)
  include snippets/cloudflare-authenticated-origin-pull.conf;

  # Visitor IP from CF-Connecting-IP, for logs, allow/deny and the upstream
  # (generated by scripts/update-cloudflare-ips.sh)
  include snippets/real-cloudflare.conf;

  # Optional: restrict to own IPs. Works with the visitor IP restored above.
  # allow 1.2.3.4;
  # deny all;

  location / {
    # Upstream
    resolver 127.0.0.11 valid=30s;
    set $upstream container_name;
    proxy_pass http://$upstream;

    # Headers, HTTP/1.1 and WebSocket upgrade. X-Real-IP and X-Forwarded-For
    # carry the visitor IP, the upstream does not need to know Cloudflare.
    include snippets/proxy.conf;
  }
}
